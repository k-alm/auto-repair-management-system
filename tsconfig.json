{
  "compilerOptions": {
    "lib": [
      "es2024",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Error",
      "ESNext.Iterator",
      "ESNext.Promise"
    ],
    "module": "ESNext",
    "target": "ES2024",
    "types": ["node"],

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",

    "paths": { "@/*": ["./src/*"] },

    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src", "test"],
  "exclude": ["node_modules", "dist"]
}
