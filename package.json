{
  "name": "auto-repair-management-system",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm typecheck && tsx watch --env-file=.env src/server.ts",
    "start": "pnpm typecheck && tsx --env-file=.env src/server.ts",
    "build": "pnpm typecheck && tsup src/server.ts --format esm --platform node --target node24 --out-dir dist --clean --sourcemap",
    "typecheck": "tsc --noEmit",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "security:audit": "pnpm audit --prod",
    "security:audit:report": "pnpm audit --prod && node -e \"require('node:fs').mkdirSync('docs/security',{recursive:true})\" && pnpm audit --prod > docs/security/pnpm-audit.txt && node -e \"require('node:fs').copyFileSync('docs/security/pnpm-audit.txt','docs/security/pnpm-audit-report.txt')\"",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "testcontainers": "^12.2.1",
    "tsup": "^9.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.1.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/swagger": "^9.7.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@scalar/fastify-api-reference": "^1.59.3",
    "bcrypt": "^6.0.0",
    "fastify": "^5.8.5",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^6.1.0",
    "nodemailer": "^8.0.3",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.0.0",
  "type": "module"
}
